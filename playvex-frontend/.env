# Backend API Base URL
# Option 1 (Local Dev with Vite Proxy): Leave empty. Vite proxies /api to http://localhost:8080
# Option 2 (Local Dev direct): VITE_API_BASE_URL=http://localhost:8080
# Option 3 (Production): VITE_API_BASE_URL=https://<your-backend-url>.onrender.com
VITE_API_BASE_URL=https://playvex-backend.onrender.com